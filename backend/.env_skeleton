# Copy to Group_4/.env (repo root) and fill in. Never commit .env.

# Django core settings
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM provider for AI reports and the help chatbot
LLM_API_ENDPOINT=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=
REPORT_LLM_MODELS=
HELP_LLM_MODEL=
HELP_EMBED_MODEL=ONCAMPUS/BAAI/bge-m3
HELP_MIN_SCORE=0.40
ALLOW_DEMO_SEEDING=True

# Redis broker for Celery, and the Django cache
CELERY_BROKER_URL=redis://localhost:6379/0
DJANGO_CACHE=redis://localhost:6379/3
CELERY_TASK_ALWAYS_EAGER=False
